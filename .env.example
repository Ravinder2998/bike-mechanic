# Server
PORT=8080
NODE_ENV=development
# Optional: use an absolute path for a different SQLite database.
# DB_PATH=C:/path/to/ridecare.sqlite
# Comma-separated production browser origins. Leave empty for same-origin local use.
# ALLOWED_ORIGIN=https://example.com

# Bootstrap only: set a strong value before the first start to create the first CMS user.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Workshop Administrator
INITIAL_ADMIN_PASSWORD=1234
SESSION_TTL_HOURS=24
